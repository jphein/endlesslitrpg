# The HTTP surface: chapter API, Range-capable PCM for the watch, RSS feed,
# /api/version for status.realm.watch.
#
#   sudo cp deploy/litrpg-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now litrpg-daemon
#   curl -s http://localhost:8093/api/version | jq
#
# Plain HTTP, no TLS. The watch client does no name resolution today, so it reaches
# this at a literal 10.0.6.129:8093 — katana, matching LITRPG_BASE_URL below. (The
# spec's §9.1 says 10.0.6.107, which is familiar, where the daemon was *designed* to
# run per D4. It is on katana today, so nothing answers on .107 — the address is
# right and the host moved.)
#
# The lease IS pinned, checked on gatekeeper rather than inferred:
#
#   dhcp.@host[22].name='katana'    ip='10.0.6.129' mac='00:D8:61:BB:9F:8E' dns='1'
#   dhcp.@host[103].name='familiar' ip='10.0.6.107' mac='04:d9:f5:fa:1e:e0' dns='1'
#
# An earlier version of this comment claimed there was no reservation, reasoning from
# `ip addr` reporting `10.0.6.129/24 dynamic`. That word means only "obtained via
# DHCP", which is exactly what a MAC reservation looks like from the client — the
# client cannot distinguish reserved from unreserved, and only the server knows. Do
# not re-derive this from the client side.
#
# `dns='1'` also means dnsmasq already resolves these: `katana.lan` -> 10.0.6.129
# answers on the LAN today. So the *server* half of using a name is done, and a
# resolver on the watch — a few KB — would let it survive any future address change
# without new infrastructure and without needing story.jphe.in to exist.

[Unit]
Description=endless-litrpg — HTTP surface
Documentation=https://github.com/jphein/endlesslitrpg
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jp
Group=jp
WorkingDirectory=/home/jp/Projects/endlesslitrpg

Environment=LITRPG_CONFIG=/home/jp/Projects/endlesslitrpg/litrpg.toml
Environment=RUST_LOG=info
# Client-facing base URL. Must NOT be derived from bind_addr: binding 0.0.0.0 is
# correct (serve every interface) but "http://0.0.0.0:8093" is not reachable by
# anything, so every pcm_url, mp3_url and RSS enclosure would be broken for the
# watch, Candela and any podcast app while working perfectly in a local curl.
Environment=LITRPG_BASE_URL=http://10.0.6.129:8093

ExecStart=/home/jp/Projects/endlesslitrpg/target/release/litrpg-daemon

Restart=always
RestartSec=5

# Reads chapters and writes only the playback cursor and director notes, so it
# needs the database but not the media directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/jp/Projects/endlesslitrpg/data
ReadOnlyPaths=/home/jp/Projects/endlesslitrpg/media

[Install]
WantedBy=multi-user.target
